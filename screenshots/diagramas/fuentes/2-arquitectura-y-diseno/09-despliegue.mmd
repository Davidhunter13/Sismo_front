  end
  subgraph EXTN["«nodo» Servicios de Internet"]
    US["USGS"]
    OS["OpenStreetMap / ruteo"]
    GE["ArcGIS / Photon"]
  end
  APK -- "HTTPS :443 (REST + Bearer)" --> AP
  APK -- "HTTPS :443" --> MSV
  APK -- HTTPS --> US & OS & GE
