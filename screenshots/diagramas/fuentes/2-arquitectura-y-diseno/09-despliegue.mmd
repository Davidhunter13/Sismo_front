    AP --> CI
    CI --- ENV
    CI --- CA
  end
  subgraph DBN["«nodo» Servidor de base de datos"]
    MY[("MySQL / MariaDB<br/>esquema sismo_*")]
  end
  subgraph MAILN["«nodo» Servidor de correo de alertas"]
    MSV["«artefacto» Servicio de correo<br/>(POST JSON)"]
    SMTP["Proveedor de correo"]
