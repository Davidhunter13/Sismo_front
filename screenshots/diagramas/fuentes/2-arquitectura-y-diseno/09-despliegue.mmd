%% title: Diagrama de despliegue
flowchart TB
  subgraph PHONE["«dispositivo» Teléfono Android"]
    APK["«artefacto» APK SISMO<br/>WebView + plugins Capacitor"]
    LSA[("localStorage")]
    APPS["SMS · WhatsApp · Marcador"]
    APK --- LSA
    APK --> APPS
  end
  subgraph PC["«dispositivo» Computador del operador / visitante"]
    BR["«entorno» Navegador web<br/>Panel SISMO · Página informativa · build web de la app"]
  end
  subgraph SRV["«nodo» Servidor web de producción (HTTPS)"]
    AP["«entorno» Apache + PHP 7.3"]
    CI["«artefacto» CodeIgniter 3<br/>Sismo · Sismo_admin · Sismo_info · Sismo_model"]
    ENV["Variables de entorno<br/>SISMO_LLAVE_CIFRADO · SISMO_CORS_ORIGENES"]
