%% title: Diagrama de clases — Backend (CodeIgniter 3) · tercera entrega
classDiagram
  direction TB
  class CI_Controller { <<framework>> }
  class CI_Model { <<framework>> }
  class Sismo {
    <<API REST de la app>>
    -execution_id : string
    +registro()
    +estado()
    +ajustes()
    +contactos(id)
    +alertas(id)
    +puntos_encuentro(id)
    +encuestas(id)
    +inventario()
    +ficha_medica()
    +codigo_recuperacion()
    +recuperar()
    +atencion()
    +correo_alerta(id)
    -asunto_correo()
    -cuerpo_correo()
    +catalogos()
    +eliminar_cuenta()
  }
  class Sismo_admin {
    <<Panel de monitoreo>>
    +index()
    +datos()
    +pulso()
    +usuario(id)
    +atender()
    +codigo()
    +sismos()
    +catalogos()
    +catalogo_guardar()
    +guia_guardar()
    +parametro_guardar()
    +plantilla_guardar()
    +correo_contactos()
  }
  class Sismo_info {
    <<Página pública>>
    +index()
  }
  class Sismo_model {
    +registrar()
    +usuario_por_token()
    +guardar_ajustes()
    +guardar_por_cliente()
    +desactivar_por_cliente()
    +guardar_inventario()
    +guardar_ficha_medica()
    +estado()
    +generar_codigo_recuperacion()
    +recuperar()
    +eliminar_cuenta()
    +atencion_vigente()
    +resumen()
    +alertas_panel()
    +usuarios_panel()
    +registrar_atencion()
    +catalogos_app()
    +guardar_catalogo()
    +guardar_guia()
    +guardar_parametro()
    +catalogos_admin()
    +tiene_correos()
    +destinatarios_correo()
    +correo_ya_enviado()
    +correos_ultima_hora()
    +registrar_correo()
    +correos_usuario()
    +tiene_correos_operador()
    +correos_operador_ultima_hora()
    +registrar_correo_operador()
    +firma_panel()
    +guardar_plantilla()
    +sismos_recientes()
    -cifrar() AES-256-GCM
    -descifrar()
  }
  class Sesion_persona {
    <<librería>>
    +persona()
    +nombre()
    +correo()
    +es_admin_sismo()
    +csrf_token()
  }
  class Html_seguro {
    <<librería>>
    +limpiar(html) lista blanca
  }
  class Sismo_correo {
    <<librería>>
    +asunto(tipo)
    +cuerpo_automatico()
    +cuerpo_centro()
    +enviar(Para, CCO)
  }
  class PHP_Mailer {
    <<librería>>
    +enviarcorreo(correo)
  }
  class ServicioCorreo {
    <<servicio externo>>
    +POST alerta(JSON)
  }
  CI_Controller <|-- Sismo
  CI_Controller <|-- Sismo_admin
  CI_Controller <|-- Sismo_info
  CI_Model <|-- Sismo_model
  Sismo --> Sismo_model : usa
  Sismo --> Sismo_correo : correo de alerta y avisos
  Sismo_admin --> Sismo_correo : correo del centro a los contactos
  Sismo_correo --> PHP_Mailer : envía como «SISMO»
  PHP_Mailer --> ServicioCorreo : POST (token en variable de entorno)
  Sismo_admin --> Sismo_model : usa
  Sismo_admin --> Sesion_persona : autoriza
  Sismo_admin --> Html_seguro : limpia mensajes
  Sismo_info --> Sesion_persona : muestra «Ir al panel»
