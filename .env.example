# Copie este archivo como .env (no se sube a git) y complete los valores.

# URL base del API de sincronización (backend en CodeIgniter 3), sin barra final. Ej.: https://servidor.ejemplo/sismo
# Vacía: todo se guarda solo en el teléfono. Con valor: los cambios se suben (y se encolan si no hay red), y el correo
# de alerta a los contactos se envía por este mismo API (POST {URL}/correo_alerta/{id}; contrato en src/services/emailService.ts).
VITE_SISMO_API_URL=http://localhost:8080/<ruta-del-backend>/sismo
