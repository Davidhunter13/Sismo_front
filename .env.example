# Copie este archivo como .env (no se sube a git) y complete los valores.

# URL del servidor que envía el correo de alerta a los contactos (POST JSON; contrato en src/services/emailService.ts).
# Vacía: la app no envía correos y lo indica como «falta conectar el servidor».
VITE_ALERT_EMAIL_URL=

# URL base del API de sincronización (backend en CodeIgniter 3), sin barra final. Ej.: https://servidor.ejemplo/sismo
# Vacía: todo se guarda solo en el teléfono. Con valor: los cambios se suben (y se encolan si no hay red).
VITE_SISMO_API_URL=http://localhost:8080/intranet/sismo
